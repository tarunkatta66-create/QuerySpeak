# Database connection string for MySQL (used by FastAPI / SQLAlchemy)
DATABASE_URL=mysql+aiomysql://root:rootpassword@localhost:3306/queryspeak

# Secret key for JWT token encoding and decoding
JWT_SECRET=your_jwt_secret_key_here

# LLM provider for query processing (e.g. openai, anthropic, mock)
LLM_PROVIDER=openai

# Redis connection URL for caching and task queues
REDIS_URL=redis://localhost:6379/0
